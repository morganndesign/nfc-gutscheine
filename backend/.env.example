# ---------------------------------------------------------------------------
# GiftCard Pro API — environment configuration
# See docs/ENVIRONMENT.md for a description of every variable.
# ---------------------------------------------------------------------------
APP_NAME="GiftCard Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Local time for nightly jobs (expiry 00:15, reminders 10:00). Database timestamps stay UTC.
SCHEDULE_TIMEZONE=Europe/Vienna
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_AT
APP_MAINTENANCE_DRIVER=cache

# Frontend (Next.js). Used for invitation and password-reset links.
FRONTEND_URL=http://localhost:3000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=giftcard_pro
DB_USERNAME=giftcard
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_COOKIE=giftcardpro_session

# Hosts (with port) whose browser requests are authenticated with session cookies.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SANCTUM_TOKEN_PREFIX=gcp_

CACHE_STORE=redis
CACHE_PREFIX=giftcardpro
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Local development: "failover" = Mailpit (SMTP on 127.0.0.1:1025, inbox http://localhost:8025) when it is
# running, otherwise the e-mail is written to storage/logs/laravel.log. Nothing to change between setups.
# Production sets MAIL_MAILER=smtp and the real server in the deployment (Coolify), not here.
MAIL_MAILER=failover
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@giftcardpro.app"
MAIL_FROM_NAME="${APP_NAME}"

# Security tuning
# Failed voucher scans per restaurant, user and device before a short lockout
PRESENTMENT_FAILURE_LIMIT=10
PRESENTMENT_FAILURE_DECAY=300
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15
API_TOKEN_MAX_DAYS=365

# Platform ceilings for the restaurants' voucher limits (minor units)
LIMIT_MAX_VOUCHER_BALANCE=50000
LIMIT_MAX_DEBIT_PER_TRANSACTION=25000
LIMIT_MAX_DEBIT_PER_VOUCHER_PER_DAY=50000

# NTAG 424 DNA SUN verification test keys (32 hex chars each). Local development only: from Phase 1 the keys
# live in Google Cloud HSM behind the crypto service and never in an environment file.
NTAG424_META_READ_KEY=
NTAG424_FILE_READ_KEY=
NTAG424_DIVERSIFY_KEYS=true

VOUCHER_EXPIRING_NOTICE_DAYS=30

# Seed the demo restaurant in non-local environments (never in production!)
SEED_DEMO_DATA=false
