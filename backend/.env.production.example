# Laravel production environment (copy to backend/.env.production on the server)
APP_NAME="GiftCard Pro"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://app.giftcardpro.at
FRONTEND_URL=https://app.giftcardpro.at
CARD_BASE_URL=https://app.giftcardpro.at
APP_LOCALE=en
APP_FAKER_LOCALE=de_AT

LOG_CHANNEL=stderr
LOG_LEVEL=info
SCHEDULE_TIMEZONE=Europe/Vienna    # local time for nightly expiry (00:15) and reminders (10:00)

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=giftcard_pro
DB_USERNAME=giftcard
DB_PASSWORD=change-me-long-random

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change-me-long-random
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=giftcardpro_session
SESSION_DOMAIN=app.giftcardpro.at
SANCTUM_STATEFUL_DOMAINS=app.giftcardpro.at
SANCTUM_TOKEN_PREFIX=gcp_

CACHE_STORE=redis
CACHE_PREFIX=giftcardpro
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

MAIL_MAILER=smtp
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@giftcardpro.at"
MAIL_FROM_NAME="${APP_NAME}"

NTAG424_META_READ_KEY=         # php artisan giftcard:nfc-keys
NTAG424_FILE_READ_KEY=
NTAG424_DIVERSIFY_KEYS=true

SEED_DEMO_DATA=false
