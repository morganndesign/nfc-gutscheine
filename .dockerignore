**/.git
dashboard
**/node_modules
**/.next
backend/vendor
# No environment file ever enters an image; configuration comes from the container environment.
**/.env
**/.env.*
!**/.env.example
# Runtime data of a development checkout (keystore, generated APP_KEY, uploads): never baked into an image, where
# Docker would copy it into a fresh laravel-storage volume on the first start. The Dockerfile creates the folders.
backend/storage/app
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/database/database.sqlite
docs
releases
signing
assets
waiter-app
e2e
backend/bootstrap/cache/*.php
