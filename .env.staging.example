# Compose-level variables of a STAGING server (copy to .env.production on the staging server, next to
# docker-compose.yml). Same stack as production, own domain, own passwords, own database.
APP_DOMAIN=<staging-domain>
ACME_EMAIL=<your e-mail>
REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest
DB_DATABASE=giftcard_pro
DB_USERNAME=giftcard
DB_PASSWORD=change-me-long-random
DB_ROOT_PASSWORD=change-me-long-random
REDIS_PASSWORD=change-me-long-random
# Native waiter app links (optional until the app is published)
WAITER_IOS_APP_IDS=
# Staging waiter app: WAITER_ANDROID_PACKAGE=eu.tapredeem.waiter.staging
WAITER_ANDROID_PACKAGE=
WAITER_ANDROID_CERT_SHA256=
