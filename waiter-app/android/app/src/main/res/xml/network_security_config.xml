<?xml version="1.0" encoding="utf-8"?>
<!-- Release and profile builds (09 §7.10): TLS only, no cleartext, system CAs only
     (user-installed CAs are not trusted). No certificate pinning in v1. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
