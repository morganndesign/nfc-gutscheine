    "success": { "$type": "haptic", "$value": { "severity": 3, "ios": { "generator": "notification", "type": "success" }, "android": { "api30": { "constants": ["CONFIRM"], "waveform": { "timings": [0, 20, 60, 30], "amplitudes": [0, 160, 0, 255] }, "waveformDelayMs": 40 }, "fallback": { "waveform": { "timings": [0, 20, 60, 30], "amplitudes": [0, 160, 0, 255] } } } }, "$description": "Money moved. Paired with sound.success." },
