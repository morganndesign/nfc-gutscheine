    "error": { "$type": "haptic", "$value": { "severity": 5, "ios": { "generator": "notification", "type": "error" }, "android": { "api30": { "constants": ["REJECT"] }, "fallback": { "waveform": { "timings": [0, 40, 60, 40, 60, 40], "amplitudes": [0, 255, 0, 255, 0, 255] } } } }, "$description": "Failed / blocked." },
