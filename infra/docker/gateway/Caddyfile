# ---------------------------------------------------------------------------
# GiftCard Pro gateway — the single public entry point behind Coolify's proxy.
#
#   Internet ──HTTPS──▶ Coolify proxy (Traefik/Caddy, TLS certificates, domain)
#            ──HTTP───▶ gateway:80 (this file)
#                         ├─ /api/* /sanctum/* /up /t/*  ─FastCGI─▶ api:9000 (Laravel, php-fpm)
#                         └─ everything else        ─HTTP────▶ web:3000 (Next.js)
#
# One origin for the whole product, so session cookies, CSRF and the waiter app's
# API calls work exactly as designed. TLS is terminated by Coolify, not here.
# ---------------------------------------------------------------------------
{
	auto_https off
	admin off
	servers {
		# Coolify's proxy is on the same Docker network: trust its X-Forwarded-* headers
		# (scheme https, client IP) and pass them on to Laravel and Next.js.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
	}
	# Caddy's own log (upstream errors also print the request): same redaction as the access log (audit L1).
	log default {
		output stderr
		format filter {
			wrap json
			request>uri query {
				delete token
				delete email
				delete e
				delete m
			}
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>X-Device-Id delete
			request>headers>Idempotency-Key delete
		}
	}
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Default only: the guest tap page (/t/*) sends no-referrer, its URL carries SUN values.
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Container health check (docker-compose.coolify.yml). Answers without touching the apps.
	handle /gateway-health {
		respond "ok" 200
	}

	# Laravel: API, Sanctum CSRF cookie, health check (/up checks database + cache), guest tap page (tap domain).
	@laravel path /api/* /sanctum/* /up /t/*
	handle @laravel {
		# The API has no static files: every request goes to Laravel's front controller.
		# REQUEST_URI keeps the original path and query, so Laravel routing works unchanged.
		rewrite * /index.php
		reverse_proxy {$API_FASTCGI:api:9000} {
			transport fastcgi {
				root /var/www/html/public
				split .php
			}
		}
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM:web:3000}
	}

	# Access log without secrets (audit L1). Invitation and reset links carry their token in the URL fragment,
	# which browsers never send; query parameters that could still carry personal data or card SUN values are
	# removed anyway, and credentials in headers are never logged. Rotation: docker-compose logging options.
	log {
		output stdout
		format filter {
			wrap json
			request>uri query {
				delete token
				delete email
				delete e
				delete m
			}
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>X-Device-Id delete
			request>headers>Idempotency-Key delete
			resp_headers>Set-Cookie delete
		}
	}
}
