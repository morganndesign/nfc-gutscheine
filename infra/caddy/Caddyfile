# ---------------------------------------------------------------------------
# GiftCard Pro — edge proxy. Automatic HTTPS (Let's Encrypt), HTTP/3, HSTS.
# One origin for the whole product: /api + /sanctum → Laravel, everything else → Next.js.
# ---------------------------------------------------------------------------
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Laravel: API, Sanctum CSRF cookie, health check, password-reset redirect.
	@laravel path /api/* /sanctum/* /up /reset-password/*
	handle @laravel {
		# The API has no static files: every request goes to Laravel's front controller.
		# REQUEST_URI keeps the original path, so Laravel routing works unchanged.
		rewrite * /index.php
		reverse_proxy api:9000 {
			transport fastcgi {
				root /var/www/html/public
				split .php
			}
		}
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
