# =============================================================================
# GiftCard Pro — production environment for Coolify (docker-compose.coolify.yml)
#
# This file is a REFERENCE, it is not read by anything. In Coolify, open the resource →
# "Environment Variables" → "Developer view" and paste only the lines you want to change.
# Every variable has a working default in docker-compose.coolify.yml; the deployment
# starts without any of them. Never commit real values.
#
# Staging: the same compose file as a second Coolify resource with APP_ENV=staging and
# its own domain.
# =============================================================================

# -----------------------------------------------------------------------------
# Generated by Coolify — do not set, do not change after the first deploy
# -----------------------------------------------------------------------------
# SERVICE_URL_GATEWAY / SERVICE_FQDN_GATEWAY   from the domain of the "gateway" service
# SERVICE_PASSWORD_MYSQL                       MySQL password of the app user
# SERVICE_PASSWORD_MYSQLROOT                   MySQL root password (backups)
# SERVICE_PASSWORD_REDIS                       Redis password
# (Changing a database password after the first deploy locks the app out of the existing
#  database volume.)

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# production | staging. staging uses the same checks (https URLs required).
APP_ENV=production

# Encryption key. Empty = generated on the first deploy and kept in the "laravel-storage"
# volume. To manage it yourself (recommended once live): copy it from the volume
# (docs/DEPLOYMENT.md → "Back up the APP_KEY") or create one with
#   echo "base64:$(openssl rand -base64 32)"
# and set it here. Never change it on a running system: everybody is signed out and
# encrypted values become unreadable.
APP_KEY=

# Public URL. Empty = taken from the domain of the "gateway" service (recommended).
# Set only if the canonical URL differs from the first gateway domain.
APP_URL=

# UI language fallback for e-mails; nightly jobs run in this timezone.
APP_LOCALE=en
SCHEDULE_TIMEZONE=Europe/Vienna
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# E-mail — REQUIRED for real use (invitations, password links, voucher e-mails).
# Without it, MAIL_MAILER=log only writes mails to the container log.
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
# smtp (STARTTLS on 587) or smtps (TLS on 465)
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
# Empty = no-reply@<your domain>
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="GiftCard Pro"
# Language of invitation e-mails when the restaurant's language has no translation (de | en).
MAIL_LOCALE=de
# Seconds before a slow mail server is given up (mail is sent from the queue and retried).
MAIL_TIMEOUT=10
# Receives operational alerts (queue backlog, failed integrity check). Empty = the platform support address.
OPS_ALERT_EMAIL=

# -----------------------------------------------------------------------------
# Card keys never live in environment variables: NTAG 424 DNA keys are held in
# Google Cloud HSM behind the crypto service (Phase 1).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Database, backups, resources
# -----------------------------------------------------------------------------
# Database and user name — only before the first deploy.
DB_DATABASE=giftcard_pro
DB_USERNAME=giftcard
# Daily dump into the "mysql-backups" volume (UTC time) and how long dumps are kept.
BACKUP_TIME=01:30
BACKUP_KEEP_DAYS=14
# Off-site copy of the backups (required before real money), encrypted with rclone crypt; values obscured with
# `docker run --rm rclone/rclone:1.68 obscure '<secret>'`. See docs/DEPLOYMENT.md#backups.
OFFSITE_SFTP_HOST=
OFFSITE_SFTP_PORT=23
OFFSITE_SFTP_USER=
OFFSITE_SFTP_PASS_OBSCURED=
OFFSITE_CRYPT_PASSWORD_OBSCURED=
OFFSITE_CRYPT_SALT_OBSCURED=
OFFSITE_TIME=02:30
OFFSITE_KEEP_DAYS=60

# -----------------------------------------------------------------------------
# Physical cards
# -----------------------------------------------------------------------------
# Required: opens the card keystore (openssl rand -base64 32, prefixed with base64:). Keep a copy offline.
CRYPTO_KEYSTORE_KEY=
# Written into every card; permanent once the first card is personalised. Default: APP_URL + /t
TAP_URL=
